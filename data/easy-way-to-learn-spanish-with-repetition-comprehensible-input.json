{"version":2,"slug":"easy-way-to-learn-spanish-with-repetition-comprehensible-input","videoId":"rKhPeDyKJ1g","videoUrl":"https://youtu.be/rKhPeDyKJ1g","lang":"es","title":"Easy Way to LEARN SPANISH with REPETITION // Comprehensible Input","category":"Vlog","channel":"Spanish After Hours","tags":["Spanish","compréhensible input"],"backUrl":"/index.html","lines":[{"start":0,"text":"Tengo hambre.","ipa":"tenɡo ambɾe"},{"start":1,"text":"Quiero comer.","ipa":"kieɾo komeɾ"},{"start":3,"text":"Así que voy a preparar la comida.","ipa":"asi ke boi a pɾepaɾaɾ la komida"},{"start":7,"text":"La comida de hoy es curry.","ipa":"la komida de oi es kuri"},{"start":12,"text":"¿Qué ingredientes necesito para preparar curry?","ipa":"ke inɡɾedientes neθesito paɾa pɾepaɾaɾ kuri"},{"start":18,"text":"hmmm","ipa":"mmm"},{"start":19,"text":"Especias.","ipa":"espeθias"},{"start":21,"text":"Como el curry.","ipa":"komo el kuri"},{"start":22,"text":"Esto es curry.","ipa":"esto es kuri"},{"start":26,"text":"Es curry en polvo.","ipa":"es kuri en polbo"},{"start":28,"text":"Curry amarillo.","ipa":"kuri amaɾiʝo"},{"start":31,"text":"Huele muy bien.","ipa":"uele mui bien"},{"start":33,"text":"Tengo curry, pero también tengo comino.","ipa":"tenɡo kuri peɾo tambien tenɡo komino"},{"start":38,"text":"Esto es comino.","ipa":"esto es komino"},{"start":41,"text":"Y también tengo Garam Masala.","ipa":"i tambien tenɡo ɡaɾam masala"},{"start":45,"text":"Esto son especias.","ipa":"esto son espeθias"},{"start":48,"text":"curry, garam masala, comino","ipa":"kuri ɡaɾam masala komino"},{"start":51,"text":"Pero necesito más ingredientes","ipa":"peɾo neθesito mas inɡɾedientes"},{"start":54,"text":"para la base del curry.","ipa":"paɾa la base del kuri"},{"start":56,"text":"Puedo usar las especias y","ipa":"puedo usaɾ las espeθias i"},{"start":62,"text":"ajos","ipa":"axos"},{"start":63,"text":"Esto es una cabeza de ajo.","ipa":"esto es una kabeθa de axo"},{"start":70,"text":"Una cabeza.","ipa":"una kabeθa"},{"start